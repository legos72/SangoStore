# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/diasporamarket
DB_HOST=localhost
DB_PORT=5432
DB_NAME=diasporamarket
DB_USER=postgres
DB_PASSWORD=yourpassword

# JWT
JWT_SECRET=your_very_strong_secret_key_here_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Escrow / Orange Money (simulation)
ORANGE_MONEY_API_URL=https://api.orange.com/orange-money-webpay/cm/v1
ORANGE_MONEY_CLIENT_ID=your_client_id
ORANGE_MONEY_CLIENT_SECRET=your_client_secret

# File storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sangostore78@gmail.com
SMTP_PASS=your_smtp_password

# App
FRONTEND_URL=http://localhost:3000
ADMIN_EMAIL=sangostore78@gmail.com
